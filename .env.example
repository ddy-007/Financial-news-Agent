# ===== DeepSeek LLM（全局默认） =====
# 下面四组「按环节配置」的所有字段留空时，一律回落到这里的 DEEPSEEK_*。
# 也就是说：只填这一组，行为与拆分前完全一致。
DEEPSEEK_API_KEY=sk-xxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ===== 按环节分组的 LLM（可选，留空即回落上面的 DEEPSEEK_*） =====
# 用途：不同环节各接一个服务商 / 模型，互不影响。
# 三个字段可以只填其中一部分，例如只想换新闻采集的模型，就只填 NEWS_MODEL。
#
# news —— 每日新闻采集（新闻分类 / 语义判重 / 情绪打分）
NEWS_API_KEY=
NEWS_BASE_URL=
NEWS_MODEL=
NEWS_DISABLE_THINKING=false
#
# expert —— 多专家研判（4 位分析师 / 风险官 / 首席 / 兜底 / 评估层）
EXPERT_API_KEY=
EXPERT_BASE_URL=
EXPERT_MODEL=
EXPERT_DISABLE_THINKING=false
#
# chat —— 前端问答 Agent
CHAT_API_KEY=
CHAT_BASE_URL=
CHAT_MODEL=
CHAT_DISABLE_THINKING=false
#
# weekly —— 周报
WEEKLY_API_KEY=
WEEKLY_BASE_URL=
WEEKLY_MODEL=
WEEKLY_DISABLE_THINKING=false

# ===== 关闭「思考模式」（按环节，可选） =====
# 填 true 才生效。只对**不需要推理**的环节开。
#
# 实测（百炼 qwen3.8-flash，同一批 20 条新闻分类）：
#   默认（带思考）29.7s   ->   NEWS_DISABLE_THINKING=true  8.0s   —— 快 3.7 倍
# 分类 / 判重 / 情绪打分这类任务，模型花在思考上的时间纯属浪费。
# 研判环节建议**保持思考**（那是分析任务，思考有价值）。
#
# ⚠️ 该参数（enable_thinking）是百炼 / qwen 系模型特有的。
#    分组指向其它服务商时**不要开**，否则请求里会多出对方不认识的参数。

# ===== LLM 请求超时（秒） =====
# 不设时 openai SDK 默认 600s；主备都挂时单个 attempt 会拖到 1200s。
LLM_TIMEOUT=120

# ===== 备用模型（可选，主模型失败时自动切换） =====
# 三项**全部填了**才启用；任何一项留空 = 不启用，行为与没有这个功能完全一样。
#
# 什么时候会切：连接失败 / 超时 / 429 限流 / 5xx / 404 模型不存在 / 401·403 认证失败
# 什么时候不切：400 参数错误（请求本身有问题，换谁都会失败）
#
# 填**不同**的服务商/模型都可能有用，看故障类型：
#   · 欠费、key 失效 —— 账号级的，换模型名没用，得换服务商
#   · **免费额度耗尽** —— 实测**按模型**算（同一账号同一 key 下，qwen3.7-flash
#     报 403，qwen3.6-plus 正常）。所以同服务商换一个有额度的模型**是有效的**
#   · 限流是否账号级**未实测**，别照搬上面任何一条
# 注意：备用与主模型**完全相同**（key/base_url/model 三项）会被自动剔除，等于没配。
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_MODEL=

# 追加备用模型：**逗号分隔**，与上面三项**共用** key / base_url。
# 顺序即尝试顺序 —— 排在 LLM_FALLBACK_MODEL 之后，前面的都失败才轮到它。
#   例：LLM_FALLBACK_MODELS=qwen3.5-plus,qwen-max
# 分隔符为什么是逗号而不是斜杠：主流平台的模型名**本身带斜杠**
# （OpenRouter 是 `qwen/qwen3.6-plus`、硅基流动是 `Qwen/Qwen3-...`），用斜杠没法解析。
#
# ⚠️ 两条已知局限（实测确认，2026-09-21）：
#   1. 只对上一条列出的那几类错误逐级降级。若**中间某个备用**抛的是**未列出**的错误
#      （主要是 400），整条链会当场中断，后面更靠后的备用**拿不到机会**。
#      这是 LangChain `with_fallbacks` 的语义，不是配置问题。
#   2. 备用个数每多一个，最坏情况就多打一次请求、多等一次超时（默认 120 秒/次）。
#      日报有约 20 次 LLM 调用 —— **别配太多**。
LLM_FALLBACK_MODELS=

# ===== Web 搜索（Tavily，免费注册 https://tavily.com） =====
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxx

# ===== 本地嵌入/重排模型 =====
# 你本地已有 bge-m3 和 bge-reranker-v2-m3，可填本地绝对路径，例如：
#   BGE_M3_MODEL_PATH=D:\Edge loaddown\mod\bge-m3
#   BGE_RERANKER_PATH=D:\Edge loaddown\mod\bge-reranker-v2-m3
# 留空或填 HuggingFace 仓库名则自动从 HF 下载
BGE_M3_MODEL_PATH=BAAI/bge-m3
BGE_RERANKER_PATH=BAAI/bge-reranker-v2-m3

# ===== 存储 =====
CHROMA_PERSIST_DIR=./data/chroma
DATABASE_URL=sqlite:///./data/app.db

# ===== 采集调度 =====
# 新闻回看天数。**注意（2026-09-22 起）它只是「没有水位线时」的回退值**：
# 采集现在是**增量**的，正常轮次的停止条件是「该源上轮水位线 − 重叠窗口」，
# 只有首次运行 / 水位线丢失 / 新增源才回退到本值。
NEWS_LOOKBACK_DAYS=1

# 增量水位线的重叠窗口（分钟）。留冗余是故意的：源站可能有发布延迟 ——
# 一条新闻发布后过一会儿才出现在 feed 里，不留重叠就永远取不到了。
# 但**窗口 = 采集间隔 + 本值**，冗余的那部分同样要过一遍 LLM 分类：
# 本值与采集间隔（30 分钟）相等时，每轮有一半条目是上轮刚抓过的。
# 2026-09-22 由 30 调为 15（窗口 45 分钟）；若出现新闻断档迹象再调大。
NEWS_OVERLAP_MINUTES=15

# 单源单轮最多翻多少页（防死循环的上限，不是正常结束条件）。
# 撞到它会在日志里留下「被截断」告警，并在采集器的状态表里落 truncated_at。
# 注意各源每页条数不同（新浪/东财 50、财联社 20），同一个数字对应的容量不同。
NEWS_MAX_PAGES=20
# 行情采集时间（收盘后，A股 15:00 收盘）
MARKET_COLLECT_TIME=17:30
# 板块数据采集时间（在行情之后）
SECTOR_COLLECT_TIME=17:40
# 每日研判生成时间
REPORT_TIME=18:15
# 周报生成时间（仅在「本周最后一个交易日」实际生成）
WEEKLY_REPORT_TIME=18:30

# ===== 情绪打分 =====
# 只对近 N 天的新闻打分（老新闻不参与研判，无需打分）
SENTIMENT_SCORE_DAYS=3

# ===== 信息量门槛（四信号任一满足即视为「有料」）=====
# 全部不满足 → low_info=True（报告仍生成，仅标记 + 内容精简）
INFO_NEW_THRESHOLD=15           # ① 今日新增新闻数
INFO_SOURCE_THRESHOLD=2         # ②a 多源佐证的 source_count 门槛
INFO_SENTIMENT_THRESHOLD=0.3    # ②b 情绪强度门槛 |sentiment|
INFO_MARKET_THRESHOLD=1.0       # ③ 市场异动 |涨跌幅| 门槛（%）

# ===== 多专家分析 =====
# 风险官措辞强度 [0,1]，0.5 中性，数值越小越尖锐
RISK_INTENSITY=0.4
# 专家权重（风险官不参与方向加权）
WEIGHT_MACRO=0.30
WEIGHT_INDUSTRY=0.25
WEIGHT_CAPITAL=0.25
WEIGHT_TECHNICAL=0.20
# 分歧度阈值
DIVERGENCE_LOW=0.5
DIVERGENCE_HIGH=1.0
# 综合分（加权平均后的 score）判定阈值 —— 三处共用，改这里三处一起变：
#   aggregate_node 定调 / compute_backtest 判方向 / _score_bucket 分档
SCORE_NEUTRAL_BAND=0.15
SCORE_STRONG_BAND=0.5
