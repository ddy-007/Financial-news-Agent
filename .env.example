# ===== DeepSeek LLM（全局默认） =====
# 下面四组「按环节配置」的所有字段留空时，一律回落到这里的 DEEPSEEK_*。
# 也就是说：只填这一组，行为与拆分前完全一致。
DEEPSEEK_API_KEY=sk-xxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ===== 按环节分组的 LLM（可选，留空即回落上面的 DEEPSEEK_*） =====
# 用途：不同环节各接一个服务商 / 模型，互不影响。
# 三个字段可以只填其中一部分，例如只想换新闻采集的模型，就只填 NEWS_MODEL。
#
# news —— 每日新闻采集（新闻分类 / 语义判重 / 情绪打分）
NEWS_API_KEY=
NEWS_BASE_URL=
NEWS_MODEL=
#
# expert —— 多专家研判（4 位分析师 / 风险官 / 首席 / 兜底 / 评估层）
EXPERT_API_KEY=
EXPERT_BASE_URL=
EXPERT_MODEL=
#
# chat —— 前端问答 Agent
CHAT_API_KEY=
CHAT_BASE_URL=
CHAT_MODEL=
#
# weekly —— 周报
WEEKLY_API_KEY=
WEEKLY_BASE_URL=
WEEKLY_MODEL=

# ===== 备用模型（可选，主模型失败时自动切换） =====
# 三项**全部填了**才启用；任何一项留空 = 不启用，行为与没有这个功能完全一样。
#
# 什么时候会切：连接失败 / 超时 / 429 限流 / 5xx / 404 模型不存在 / 401·403 认证失败
# 什么时候不切：400 参数错误（请求本身有问题，换谁都会失败）
#
# 建议指向**另一家服务商**：同一家的限流、欠费是账号级的，换个模型名照样中招。
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_MODEL=

# ===== Web 搜索（Tavily，免费注册 https://tavily.com） =====
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxx

# ===== 本地嵌入/重排模型 =====
# 你本地已有 bge-m3 和 bge-reranker-v2-m3，可填本地绝对路径，例如：
#   BGE_M3_MODEL_PATH=D:\Edge loaddown\mod\bge-m3
#   BGE_RERANKER_PATH=D:\Edge loaddown\mod\bge-reranker-v2-m3
# 留空或填 HuggingFace 仓库名则自动从 HF 下载
BGE_M3_MODEL_PATH=BAAI/bge-m3
BGE_RERANKER_PATH=BAAI/bge-reranker-v2-m3

# ===== 存储 =====
CHROMA_PERSIST_DIR=./data/chroma
DATABASE_URL=sqlite:///./data/app.db

# ===== 采集调度 =====
# 新闻回看天数
NEWS_LOOKBACK_DAYS=1
# 行情采集时间（收盘后，A股 15:00 收盘）
MARKET_COLLECT_TIME=17:30
# 板块数据采集时间（在行情之后）
SECTOR_COLLECT_TIME=17:40
# 每日研判生成时间
REPORT_TIME=18:00
# 周报生成时间（仅在「本周最后一个交易日」实际生成）
WEEKLY_REPORT_TIME=18:30

# ===== 情绪打分 =====
# 只对近 N 天的新闻打分（老新闻不参与研判，无需打分）
SENTIMENT_SCORE_DAYS=3

# ===== 信息量门槛（四信号任一满足即视为「有料」）=====
# 全部不满足 → low_info=True（报告仍生成，仅标记 + 内容精简）
INFO_NEW_THRESHOLD=15           # ① 今日新增新闻数
INFO_SOURCE_THRESHOLD=2         # ②a 多源佐证的 source_count 门槛
INFO_SENTIMENT_THRESHOLD=0.3    # ②b 情绪强度门槛 |sentiment|
INFO_MARKET_THRESHOLD=1.0       # ③ 市场异动 |涨跌幅| 门槛（%）

# ===== 多专家分析 =====
# 风险官措辞强度 [0,1]，0.5 中性，数值越小越尖锐
RISK_INTENSITY=0.4
# 专家权重（风险官不参与方向加权）
WEIGHT_MACRO=0.30
WEIGHT_INDUSTRY=0.25
WEIGHT_CAPITAL=0.25
WEIGHT_TECHNICAL=0.20
# 分歧度阈值
DIVERGENCE_LOW=0.5
DIVERGENCE_HIGH=1.0
