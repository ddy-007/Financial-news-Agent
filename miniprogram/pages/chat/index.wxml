<template name="answer-inline">
  <text class="answer-text" user-select="true"><text wx:for="{{spans}}" wx:for-item="span" wx:key="id" class="answer-inline-{{span.style}}">{{span.text}}</text></text>
</template>

<view class="page">
  <view class="card">
    <view class="answer-header">
      <text class="section-title">{{recentQuestions.length ? '继续追问' : '你的问题'}}</text>
      <button wx:if="{{recentQuestions.length}}" class="copy action" size="mini" bindtap="newConversation" disabled="{{sending}}">新对话</button>
    </view>
    <textarea
      class="question-input"
      placeholder="{{recentQuestions.length ? '可接着刚才的话题提问' : '例如：最近有哪些影响市场情绪的新闻？'}}"
      maxlength="{{maxQuestionLength}}"
      value="{{query}}"
      bindinput="onInput"
      disabled="{{sending}}"
    />
    <view class="input-count muted">{{queryLength}} / {{maxQuestionLength}}</view>
    <button class="action send" bindtap="sendQuestion" loading="{{sending}}" disabled="{{sending || !hasQuery}}">
      {{sending ? '等待回答' : '发送'}}
    </button>
    <view wx:if="{{sending}}" class="wait-note muted">
      正在检索与回答，已等待 {{elapsedSeconds}} 秒。
      <view wx:if="{{elapsedSeconds >= 30}}">复杂问题可能需要较长时间，请勿重复发送。</view>
    </view>
  </view>

  <view wx:if="{{error}}" class="error">{{error}}</view>
  <view wx:if="{{recentQuestions.length > 1}}" class="card">
    <view class="section-title">近期问答</view>
    <view wx:if="{{activeTurn !== recentQuestions[0].index}}" class="muted turn-note">正在回看。继续提问仍会接续最新对话。</view>
    <view wx:for="{{recentQuestions}}" wx:key="index" class="turn-row {{activeTurn === item.index ? 'turn-row-active' : ''}}" aria-role="button" aria-selected="{{activeTurn === item.index}}" data-index="{{item.index}}" bindtap="selectTurn">
      {{item.question}}
    </view>
  </view>
  <view wx:if="{{answer}}" class="card">
    <view class="answer-header">
      <text class="section-title">回答</text>
      <button class="copy action" size="mini" bindtap="copyAnswer">复制答案</button>
    </view>
    <text class="asked muted">{{question}}</text>
    <view class="answer-body">
      <block wx:for="{{answerBlocks}}" wx:for-item="part" wx:key="id">
        <view wx:if="{{part.kind === 'heading'}}" class="answer-block answer-heading {{part.level <= 2 ? 'answer-heading-main' : ''}}">
          <template is="answer-inline" data="{{spans: part.spans}}" />
        </view>
        <view wx:elif="{{part.kind === 'table'}}" class="answer-block">
          <view wx:for="{{part.rows}}" wx:for-item="row" wx:key="id" class="answer-table-row">
            <view wx:for="{{row.cells}}" wx:for-item="cell" wx:key="id" class="answer-table-cell">
              <view class="answer-table-label"><template is="answer-inline" data="{{spans: cell.label}}" /></view>
              <template is="answer-inline" data="{{spans: cell.spans}}" />
            </view>
          </view>
        </view>
        <view wx:elif="{{part.kind === 'item'}}" class="answer-block answer-item">
          <text class="answer-marker">{{part.marker}}</text>
          <view class="answer-item-body"><template is="answer-inline" data="{{spans: part.spans}}" /></view>
        </view>
        <view wx:elif="{{part.kind === 'code'}}" class="answer-block answer-code"><text class="answer-text" user-select="true">{{part.text}}</text></view>
        <view wx:else class="answer-block {{part.kind === 'notice' ? 'answer-notice' : ''}}">
          <template is="answer-inline" data="{{spans: part.spans}}" />
        </view>
      </block>
    </view>
  </view>
</view>
