<view class="page">
  <view class="card">
    <view class="section-title">你的问题</view>
    <textarea
      class="question-input"
      placeholder="例如：最近有哪些影响市场情绪的新闻？"
      maxlength="-1"
      value="{{query}}"
      bindinput="onInput"
      disabled="{{sending}}"
    />
    <button class="action send" bindtap="sendQuestion" loading="{{sending}}" disabled="{{sending || !hasQuery}}">
      {{sending ? '正在检索与回答…' : '发送'}}
    </button>
  </view>

  <view wx:if="{{error}}" class="error">{{error}}</view>
  <view wx:if="{{answer}}" class="card">
    <view class="section-title">回答</view>
    <text class="asked muted">{{question}}</text>
    <text class="prose" user-select="true">{{answer}}</text>
  </view>
</view>
