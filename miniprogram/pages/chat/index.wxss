.question-input {
  box-sizing: border-box;
  width: 100%;
  height: 180rpx;
  padding: 18rpx;
  border: 1rpx solid #cbd5e1;
  border-radius: 14rpx;
  background: #f8fafc;
  font-size: 28rpx;
  line-height: 1.55;
}

.send {
  margin-top: 20rpx;
  width: 100%;
}

.input-count {
  margin-top: 8rpx;
  text-align: right;
}

.wait-note {
  margin-top: 14rpx;
}

.answer-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.answer-header .section-title {
  margin-bottom: 0;
}

.copy {
  margin: 0;
  background: #d9f1ed;
  color: #115e59;
}

.asked {
  display: block;
  margin-bottom: 16rpx;
  padding-bottom: 14rpx;
  border-bottom: 1rpx solid #e2e8f0;
  overflow-wrap: anywhere;
}
