.question-input {
  box-sizing: border-box;
  width: 100%;
  height: 180rpx;
  padding: 18rpx;
  border: 1rpx solid #cbd5e1;
  border-radius: 14rpx;
  background: #f8fafc;
  font-size: 28rpx;
  line-height: 1.55;
}

.send {
  margin-top: 20rpx;
  width: 100%;
}

.asked {
  display: block;
  margin-bottom: 16rpx;
  padding-bottom: 14rpx;
  border-bottom: 1rpx solid #e2e8f0;
  overflow-wrap: anywhere;
}
