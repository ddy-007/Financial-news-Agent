.question-input {
  box-sizing: border-box;
  width: 100%;
  height: 180rpx;
  padding: 18rpx;
  border: 1rpx solid #cbd5e1;
  border-radius: 14rpx;
  background: #f8fafc;
  font-size: 28rpx;
  line-height: 1.55;
}

.send {
  margin-top: 20rpx;
  width: 100%;
}

.input-count {
  margin-top: 8rpx;
  text-align: right;
}

.wait-note {
  margin-top: 14rpx;
}

.answer-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.answer-header .section-title {
  margin-bottom: 0;
}

.copy {
  margin: 0;
  background: #d9f1ed;
  color: #115e59;
}

.asked {
  display: block;
  margin-bottom: 16rpx;
  padding-bottom: 14rpx;
  border-bottom: 1rpx solid #e2e8f0;
  overflow-wrap: anywhere;
}

.turn-note {
  margin-bottom: 8rpx;
}

.turn-row {
  padding: 14rpx 18rpx;
  border-radius: 12rpx;
  color: #334155;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.turn-row-active {
  background: #e2f2ef;
  color: #115e59;
  font-weight: 600;
}

.answer-body {
  color: #26364a;
  line-height: 1.75;
}

.answer-block + .answer-block {
  margin-top: 18rpx;
}

.answer-text {
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}

.answer-heading {
  padding-top: 8rpx;
  color: #0f172a;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 1.45;
}

.answer-heading-main {
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid #dce7ed;
  font-size: 34rpx;
}

.answer-inline-strong {
  color: #0f172a;
  font-weight: 700;
}

.answer-notice,
.answer-code,
.answer-table-row {
  padding: 18rpx 22rpx;
  border-radius: 14rpx;
}

.answer-notice {
  border-left: 6rpx solid #d97706;
  background: #fffbeb;
  color: #78350f;
}

.answer-code,
.answer-inline-code {
  background: #f1f5f9;
  color: #334155;
  font-family: monospace;
}

.answer-table-row {
  border: 1rpx solid #d9e7ec;
  background: #f8fafc;
}

.answer-table-row + .answer-table-row,
.answer-table-cell + .answer-table-cell {
  margin-top: 12rpx;
}

.answer-table-label {
  color: #115e59;
  font-size: 24rpx;
  font-weight: 700;
}

.answer-item {
  display: flex;
  align-items: baseline;
}

.answer-marker {
  flex: 0 0 auto;
  min-width: 36rpx;
  margin-right: 8rpx;
  color: #0f766e;
  font-weight: 700;
}

.answer-item-body {
  flex: 1;
  min-width: 0;
}

.source-note {
  margin-bottom: 12rpx;
}

.source-row {
  padding: 16rpx 0;
  border-top: 1rpx solid #e2e8f0;
}

.source-title {
  display: block;
  font-weight: 600;
  overflow-wrap: anywhere;
}

.source-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  margin-top: 8rpx;
}
